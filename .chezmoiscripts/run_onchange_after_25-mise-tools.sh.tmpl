#!/bin/sh

# Installs the globally pinned mise tools, so a fresh machine ends up with
# node available to mise's shims. Neovim's npm-based language servers
# (bash-language-server, json-lsp, yaml-language-server) fail to install
# without it.
#
# ~/.config/mise/config.toml hash: {{ include "dot_config/mise/config.toml" | sha256sum }}

printf '\033[1;33m=> Installing global mise tools\033[0m\n'

mise install
