#!/bin/sh

# Import GPG keys

export GPG_TTY=$(tty)

echo "{{ (bitwarden "item" "gpg_public_key").notes }}" | gpg --import -
echo "{{ (bitwarden "item" "gpg_private_key").notes }}" | gpg --import -

# Change the default shell

if [ "$SHELL" != "$(which zsh)" ]; then
	chsh -s $(which zsh)
fi

# Enable and start services

systemctl --user enable --now hyprmoncfgd

sudo systemctl enable --now cronie
sudo systemctl enable --now docker
sudo systemctl enable --now NetworkManager

# Create home directories

xdg-user-dirs-update
xdg-user-dirs-update --force

mkdir -p $HOME/Projects

# Set the timezone to local time

sudo timedatectl set-local-rtc 1

# Setup `hyprshutdown`

echo "$USER ALL=(ALL) NOPASSWD: /usr/bin/chvt" | sudo tee /etc/sudoers.d/chvt
sudo chmod 440 /etc/sudoers.d/chvt

# Install Firefox policies

POLICY_DIR="/usr/lib/firefox/distribution"

sudo mkdir -p "$POLICY_DIR"
sudo tee "$POLICY_DIR/policies.json" > /dev/null << 'EOF'
{
  "policies": {
    "SkipTermsOfUse": true,
    "DisableTelemetry": true,
    "DisableProfileImport": true,
    "OfferToSaveLogins": false,
    "Extensions": {
      "Install": [
        "https://addons.mozilla.org/firefox/downloads/latest/bitwarden-password-manager/latest.xpi",
        "https://addons.mozilla.org/firefox/downloads/latest/ublock-origin/latest.xpi",
        "https://addons.mozilla.org/firefox/downloads/latest/vimium-ff/latest.xpi"
      ]
    },
    "Homepage": {
      "StartPage": "previous-session"
    },
    "PictureInPicture": {
      "Enabled": false
    }
  }
}
EOF
